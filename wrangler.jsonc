{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roast-co-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_NAME": "Roast & Co.",
    "SESSION_TTL_DAYS": "7",
    "ALLOWED_ORIGIN": "*",
    "DEMO_ENABLED": "true"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roast-co-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "roast-co-api-staging",
      "vars": {
        "APP_NAME": "Roast & Co. (staging)",
        "SESSION_TTL_DAYS": "7",
        "ALLOWED_ORIGIN": "*",
        "DEMO_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "roast-co-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "worker/migrations"
        }
      ]
    },
    "production": {
      "name": "roast-co-api",
      "vars": {
        "APP_NAME": "Roast & Co.",
        "SESSION_TTL_DAYS": "7",
        "ALLOWED_ORIGIN": "*",
        "DEMO_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "roast-co-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "worker/migrations"
        }
      ]
    }
  }
}
