    "db:migrate:staging": "wrangler d1 migrations apply roast-co-db-staging --remote --env staging",
    "db:seed:local": "wrangler d1 execute roast-co-db --local --file=./worker/migrations/0001_init.sql",
    "web:export": "expo export --platform web"
  },
  "private": true,
  "overrides": {
    "lightningcss": "1.30.1"
